##################################
# Fatura em Dia — .gitignore
##################################

# ---------- Segredos e configuração local ----------
.env
.env.*
!.env.example
*.pem
*.key
secrets/
config/local.*

# ---------- Python (backend) ----------
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
*.egg-info/
.installed.cfg
*.egg

# Ambientes virtuais
.venv/
venv/
env/
ENV/

# Testes e cobertura
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
coverage.xml
*.cover
nosetests.xml

# Ferramentas de tipo/lint
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# ---------- Node / JavaScript (frontend) ----------
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
dist/
build/
.next/
.nuxt/
.cache/
.parcel-cache/
.vite/
coverage/

# ---------- Bancos de dados locais ----------
*.sqlite3
*.sqlite3-journal
*.db
*.db-journal

# ---------- Sistema operacional ----------
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# ---------- Editores / IDEs ----------
.vscode/
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# ---------- Logs e artefatos temporários ----------
*.log
logs/
tmp/
temp/
*.tmp

# ---------- Uploads/anexos locais de desenvolvimento ----------
uploads/
media/local/
